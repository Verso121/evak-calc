{
  "name": "evak-calc",
  "productName": "Эвак Калькулятор",
  "version": "1.0.0",
  "description": "Расчёт стоимости эвакуации",
  "author": "Evak",
  "main": "main.js",
  "build": {
    "appId": "ru.evak.calc",
    "productName": "Эвак Калькулятор",
    "artifactName": "Evak-Calculator-Setup.${ext}",
    "files": ["main.js", "icon.png", "web/**/*"],
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Эвак Калькулятор",
      "deleteAppDataOnUninstall": false
    }
  }
}
